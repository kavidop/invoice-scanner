# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Any Gemini model id; the "latest" alias tracks Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest
# Set to true to skip Gemini and return a sample extraction (handy for UI work).
GEMINI_MOCK=false

# --- Turso / libSQL ---
# Local dev: use a file DB (no account needed) -> file:local.db
# Turso:     libsql://<db-name>-<org>.turso.io  (+ token from `turso db tokens create <db-name>`)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Original documents. Local folder in dev; move to object storage before deploying.
UPLOAD_DIR=./uploads

# --- Zoho Books (default destination) ---
# Create a "Self Client" at https://api-console.zoho.com, generate a code with scope
#   ZohoBooks.contacts.ALL,ZohoBooks.bills.ALL,ZohoBooks.settings.READ,ZohoBooks.accountants.READ
# and exchange it for a refresh token (see docs/PLAN.md).
ZOHO_DC=com            # com | eu | in | com.au | jp | ca | sa
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Optional default expense account id for bill lines (you can pick one per invoice in the UI).
ZOHO_EXPENSE_ACCOUNT_ID=
# Contact field that holds the supplier's tax number in your Zoho edition:
#   vat_reg_no (EU/UK), gst_no (India), tax_reg_no (AU/NZ/CA). Leave empty to not send it.
ZOHO_TAX_ID_FIELD=
# Set to true to use an in-memory fake Zoho Books (try the export flow without credentials).
DESTINATION_MOCK=false
