# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Any Gemini model id; the "latest" alias tracks Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest
# Set to true to skip Gemini and return a sample extraction (handy for UI work).
GEMINI_MOCK=false

# --- Turso / libSQL ---
# Local dev: use a file DB (no account needed) -> file:local.db
# Turso:     libsql://<db-name>-<org>.turso.io  (+ token from `turso db tokens create <db-name>`)
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Original documents. Local folder in dev; move to object storage before deploying.
UPLOAD_DIR=./uploads

# --- Zoho Books (default destination) ---
# Create a "Self Client" at https://api-console.zoho.com, generate a code with scope
#   ZohoBooks.contacts.ALL,ZohoBooks.bills.ALL,ZohoBooks.items.ALL,ZohoBooks.settings.READ,ZohoBooks.accountants.READ
# and exchange it for a refresh token (see docs/PLAN.md).
ZOHO_DC=eu             # eu for Greek accounts (zoho.eu); com | in | com.au | jp | ca | sa
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# The organizations bills can go to (JSON, one line). taxId is the company's ΑΦΜ:
# an invoice goes to the organization whose ΑΦΜ is printed as the buyer.
# expenseAccountId is optional (default account for lines until one is remembered per supplier).
# e.g. ZOHO_ORGANIZATIONS=[{"id":"20012345","name":"Alpha Α.Ε.","taxId":"EL800000001"},{"id":"20067890","name":"Beta Ι.Κ.Ε.","taxId":"EL800000002"}]
ZOHO_ORGANIZATIONS=[]
# Contact field that holds the supplier's ΑΦΜ / VAT number (vat_reg_no for EU editions).
ZOHO_TAX_ID_FIELD=vat_reg_no
# Type of Zoho items created from invoice lines: inventory | purchases | sales_and_purchases
ZOHO_ITEM_TYPE=inventory
# Set to true to use an in-memory fake Zoho Books (try the export flow without credentials).
DESTINATION_MOCK=false
